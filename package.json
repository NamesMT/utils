{
  "name": "@namesmt/utils",
  "type": "module",
  "version": "0.5.20",
  "packageManager": "pnpm@12.4.1",
  "description": "Opinionated collection of common JavaScript / TypeScript utils on top of @antfu's opinionated collection",
  "author": "NamesMT <dangquoctrung123@gmail.com>",
  "license": "MIT",
  "funding": "https://github.com/sponsors/namesmt",
  "homepage": "https://github.com/namesmt/utils#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/namesmt/utils.git"
  },
  "bugs": "https://github.com/namesmt/utils/issues",
  "keywords": [],
  "sideEffects": false,
  "source": "./src/index.ts",
  "imports": {
    "#src/*": "./src/*"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "start": "NODE_ENV=dev tsx src/index.ts",
    "watch": "NODE_ENV=dev tsx watch src/index.ts",
    "dev": "pnpm run watch",
    "lint": "eslint .",
    "test": "vitest",
    "test:types": "tsc --noEmit --skipLibCheck",
    "check": "pnpm lint && pnpm test:types && vitest run --coverage",
    "build": "tsdown",
    "release:check": "node scripts/check-release-version.mjs",
    "release:preview": "pnpm dlx changelogen@latest",
    "prepare": "simple-git-hooks",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@antfu/utils": "^9.3.0",
    "dequal": "^2.0.3"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^5.4.1",
    "@types/node": "^22.20.2",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.37.0",
    "lint-staged": "^16.4.0",
    "simple-git-hooks": "^2.14.0",
    "tsdown": "^0.23.0",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged"
  },
  "lint-staged": {
    "*": "eslint --fix"
  }
}
